<resources>
    <!-- ========================= -->
    <!-- 📌 UNIVERSAL PRINTER DETECTION -->
    <!-- ========================= -->

    <!-- Detects ANY printer by class (MUST HAVE) -->
    <usb-device class="7" />
    <!-- class="7" = Printer Class - All USB printers fall under this category -->
    <!-- This single line works with every printer regardless of brand -->


    <!-- ========================= -->
    <!-- 📌 ALL MAJOR PRINTER BRANDS (Vendor IDs) -->
    <!-- ========================= -->

