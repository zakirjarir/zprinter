    <!-- ========================= -->
    <!-- 📌 PRINTER CLASSES (Additional) -->
    <!-- ========================= -->

    <!-- Interface class for printers -->
    <usb-device class="7" subclass="1" />      <!-- Printer subclass -->
    <usb-device class="7" subclass="1" protocol="1" /> <!-- Unidirectional -->
    <usb-device class="7" subclass="1" protocol="2" /> <!-- Bidirectional -->
    <usb-device class="7" subclass="1" protocol="3" /> <!-- IEEE 1284.4 -->
    <usb-device class="7" subclass="1" protocol="4" /> <!-- Vendor specific -->


    <!-- ========================= -->
    <!-- 📌 NOTES -->
    <!-- ========================= -->

    <!--
        💡 The first line <usb-device class="7" /> is the MOST IMPORTANT
        💡 It automatically detects ANY printer by class
        💡 All other lines are optional but help with specific models
        💡 You can add more vendor/product IDs as needed
        💡 More specific entries = faster detection for those models
    -->

</resources>